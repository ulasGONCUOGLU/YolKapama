# Bu dosyayı ".env" olarak kopyalayıp doldurun:  cp .env.example .env
# ".env" git'e eklenmez (.gitignore). Gerçek anahtarları ASLA bu dosyaya yazmayın.
#
# ÖNEMLİ: Nuxt, sunucu ayarlarını yalnızca "NUXT_" önekli değişkenlerden okur.
# Öneksiz isimler (SUPABASE_SERVICE_ROLE_KEY gibi) görmezden gelinir.

# --- Supabase (Dashboard → Project Settings → API) ---
NUXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon/public anahtar: tarayıcıda kullanımı güvenlidir (RLS ile korunur)
NUXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role/secret anahtar: RLS'i atlar. Tarayıcıya asla sızmamalı;
# bu yüzden NUXT_PUBLIC_ öneki ALMAZ (sadece NUXT_).
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# --- Python backend (Flask) ---
NUXT_PYTHON_API_BASE=http://127.0.0.1:5000
# Python backend'in .env'indeki AYNI değer (uzun, rastgele bir metin)
NUXT_INTERNAL_API_TOKEN=

# --- Nominatim (harita arama kutusu) ---
# OSM kullanım politikası gereği uygulamayı tanıtan bir User-Agent gerekir.
# Örn: YolKapama/1.0 (https://alanadiniz.com; iletisim@alanadiniz.com)
NUXT_NOMINATIM_USER_AGENT=
# İsteğe bağlı: kendi Nominatim sunucunuz. Boşsa genel OSM sunucusu kullanılır.
NUXT_NOMINATIM_URL=

# Arama kutusunda yazdıkça çıkan öneriler için Photon sunucusu.
# Boş bırakırsanız genel https://photon.komoot.io kullanılır (adil kullanım, SLA yok).
NUXT_PHOTON_URL=
